# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Vercel Queues region (see https://vercel.com/docs/regions)
VERCEL_QUEUE_REGION=iad1

# Injected automatically on Vercel; use `vercel env pull` for local queue access
VERCEL_OIDC_TOKEN=

# Anthropic API key (backend only; never exposed to the client)
# optional static key; leave empty to use workload identity federation below
ANTHROPIC_API_KEY=

# Anthropic workload identity federation (used when ANTHROPIC_API_KEY is empty; not secrets)
# set to `wif` only in Devin sessions (blueprint does this); leave empty on Vercel
ANTHROPIC_AUTH=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=

# LLM provider for runs: anthropic | fake (default: anthropic if key set, else fake)
LLM_PROVIDER=

# How runs are driven: queue (Vercel Queues) | inline | sync (default: queue, falls back to inline locally)
RUN_MODE=

# Max run creations per client IP per minute; 0 disables the rate limit (default 6)
RUN_RATE_LIMIT_PER_MIN=6

# Max validation starts per client IP per hour; 0 disables the rate limit (default 2)
VALIDATE_RATE_LIMIT_PER_HOUR=2

# Max scenario forks per client IP per hour; 0 disables the rate limit (default 10)
FORK_RATE_LIMIT_PER_HOUR=10

# Minutes before a queued/running validation job is considered stale (default 30)
VALIDATION_JOB_STALE_MIN=30

# Number of newest custom scenarios included in the picker (default 20)
CUSTOM_SCENARIOS_LISTED=20

# Auto-start a live run when the landing page loads; 0/false/off disables (default 1)
AUTO_RUN_ON_LOAD=1
