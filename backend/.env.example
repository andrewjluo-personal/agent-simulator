# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Vercel Queues region (see https://vercel.com/docs/regions)
VERCEL_QUEUE_REGION=iad1

# Injected automatically on Vercel; use `vercel env pull` for local queue access
VERCEL_OIDC_TOKEN=
