{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v1beta",
          "topic": "greetings",
          "consumer": "greetings-worker"
        },
        {
          "type": "queue/v1beta",
          "topic": "simulation",
          "consumer": "simulation-worker"
        }
      ]
    }
  }
}
